# Backend (Vercel serverless functions under /api) - server-side only, never exposed to the client.
GEMINI_API_KEY=your-google-ai-studio-api-key
GEMINI_MODEL=gemini-3.6-flash
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_MS=60000
LOG_LEVEL=info

# Frontend (Expo) - only needed for native/dev builds where the app has no
# "same origin" to call. Leave unset for the production web build, since it
# calls /api on the same Vercel deployment by default.
# EXPO_PUBLIC_API_BASE_URL=https://your-deployment.vercel.app
